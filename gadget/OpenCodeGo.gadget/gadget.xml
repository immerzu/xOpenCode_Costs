<?xml version="1.0" encoding="utf-8" ?>
<gadget>
    <name>OpenCode Go</name>
    <namespace>immerzu.opencodego</namespace>
    <version>1.0.0</version>
    <author name="immerzu">
        <logo src="src/icon.png" />
    </author>
    <copyright>2026</copyright>
    <description>Auslastung der OpenCode-Go-Limits: 5 Stunden, Woche, Monat.</description>
    <icons>
        <icon src="src/icon.png" />
    </icons>
    <hosts>
        <host name="sidebar">
            <base type="HTML" apiVersion="1.0.0" src="index.html" />
            <permissions>full</permissions>
            <defaultImage src="drag.png" />
            <platform minPlatformVersion="1.0" />
            <autoscaleDPI>true</autoscaleDPI>
        </host>
    </hosts>
    <settings width="176" height="62" />
</gadget>
